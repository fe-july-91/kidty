# Copy to .env and adjust.
DATABASE_URL="postgresql://kidty:kidty@localhost:5434/kidty?schema=public"

# API server
PORT=8088
# At least 32 random characters, e.g. `openssl rand -base64 48`.
JWT_SECRET="replace-with-a-long-random-string"
SESSION_DAYS=7
# Session cookie: SameSite (lax/strict/none) and HTTPS-only (defaults to true in production).
COOKIE_SAMESITE="lax"
# COOKIE_SECURE=true
# Comma-separated frontend origins allowed by CORS.
CORS_ORIGIN="http://localhost:3000"
# Public frontend URL, used in password reset links.
APP_URL="http://localhost:3000"

# Email. Production uses Resend (RESEND_API_KEY); locally Mailpit (docker
# compose) catches everything over SMTP: http://localhost:8025
# RESEND_API_KEY=""
SMTP_URL="smtp://localhost:1025"
MAIL_FROM="Kidty <no-reply@kidty.local>"
SUPPORT_EMAIL="support@kidty.local"

# Demo account created by `npm run db:seed` (local development only).
SEED_USER_EMAIL="demo@kidty.local"
SEED_USER_PASSWORD="demo-password-change-me"

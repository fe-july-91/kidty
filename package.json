{
  "name": "kidty",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @kidty/web",
    "dev:api": "npm run dev -w @kidty/api",
    "build": "npm run build --workspaces --if-present",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:migrate": "npm run db:migrate -w @kidty/api",
    "db:seed": "npm run db:seed -w @kidty/api",
    "db:studio": "npm run db:studio -w @kidty/api",
    "deploy:web": "npm run deploy -w @kidty/web"
  },
  "devDependencies": {
    "prettier": "^3.5.3"
  }
}
